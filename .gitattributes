# 统一换行：仓库内一律 LF，避免 Windows 上的 CRLF 噪声
* text=auto eol=lf

*.py   text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.json text eol=lf

# 二进制：不做换行转换，diff 视为二进制
*.har  binary
*.gz   binary
*.png  binary
*.jpg  binary
*.ico  binary

# 运行时缓存与本地构建产物
.u8_token        export-ignore
.u8_server       export-ignore
.u8_role         export-ignore
.u8_roles.json   export-ignore
local/site/**    linguist-vendored
